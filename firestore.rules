rules_version = '2';

// NoteVault Cloud - Firestore security rules.
//
// Only the owning user may read or write their own Drive session document.
// The server-side token route uses the user's own Firebase ID token as the
// bearer credential, so these rules apply to it as well.
//
// Deploy with:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
